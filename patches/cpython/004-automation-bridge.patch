+  if (CheckJavaException(env)) {
+    return nullptr;
+  }
+  return PyBool_FromLong(result == JNI_TRUE);
+}
+
+PyObject* BrowserEvalJs(PyObject*, PyObject* args) {
+  int tab_id = 0;
+  const char* script = nullptr;
+  if (!PyArg_ParseTuple(args, "is:eval_js", &tab_id, &script)) {
+    return nullptr;
+  }
+
+  ScopedJNIEnv scoped_env;
+  JNIEnv* env = scoped_env.get();
+  if (!env || !g_browser_bridge_class || !g_eval_js_method) {
+    PyErr_SetString(PyExc_RuntimeError, "browser: JNI bridge unavailable");
+    return nullptr;
+  }
+  base::android::ScopedJavaLocalRef<jstring> java_script =
+      base::android::ConvertUTF8ToJavaString(env, script);
+  if (CheckJavaException(env) || !java_script) {
+    if (!PyErr_Occurred()) {
+      PyErr_SetString(PyExc_RuntimeError, "browser: Java call failed");
+    }
+    return nullptr;
+  }
+  jstring result = static_cast<jstring>(env->CallStaticObjectMethod(
+      g_browser_bridge_class, g_eval_js_method,
+      static_cast<jint>(tab_id), java_script.obj()));
+  if (CheckJavaException(env)) {
+    return nullptr;
+  }
+  if (!result) {
+    return PyUnicode_FromString("");
+  }
+
+  const char* utf8 = env->GetStringUTFChars(result, nullptr);
+  if (!utf8) {
+    env->DeleteLocalRef(result);
+    if (env->ExceptionCheck()) {
+      env->ExceptionClear();
+    }
+    PyErr_SetString(PyExc_RuntimeError, "browser: Java call failed");
+    return nullptr;
+  }
+  PyObject* python_result = PyUnicode_FromString(utf8);
+  env->ReleaseStringUTFChars(result, utf8);
+  env->DeleteLocalRef(result);
+  return python_result;
+}
+
+PyMethodDef kBrowserMethods[] = {
+    {"list_tabs", BrowserListTabs, METH_VARARGS, nullptr},
+    {"current_tab", BrowserCurrentTab, METH_VARARGS, nullptr},
+    {"open_tab", BrowserOpenTab, METH_VARARGS, nullptr},
+    {"close_tab", BrowserCloseTab, METH_VARARGS, nullptr},
+    {"navigate", BrowserNavigate, METH_VARARGS, nullptr},
+    {"eval_js", BrowserEvalJs, METH_VARARGS, nullptr},
+    {nullptr, nullptr, 0, nullptr},
+};
+
+PyModuleDef kBrowserModule = {
+    PyModuleDef_HEAD_INIT,
+    "browser",
+    nullptr,
+    -1,
+    kBrowserMethods,
+    nullptr,
+    nullptr,
+    nullptr,
+    nullptr,
+};
+
+PyObject* PyInit_browser() {
+  if (!g_jvm) {
+    PyErr_SetString(PyExc_ImportError,
+                    "browser: CPython bridge not initialized");
+    return nullptr;
+  }
+  return PyModule_Create(&kBrowserModule);
+}
+
+bool CacheBrowserBridge(JNIEnv* env) {
+  JavaVM* jvm = nullptr;
+  if (env->GetJavaVM(&jvm) != JNI_OK || !jvm) {
+    LOG(ERROR) << "Unable to get JavaVM for CPython browser bridge";
+    return false;
+  }
+
+  jclass local_class =
+      env->FindClass("org/chromium/chrome/browser/cpython/BrowserBridge");
+  if (env->ExceptionCheck() || !local_class) {
+    env->ExceptionClear();
+    LOG(ERROR) << "Unable to find BrowserBridge class";
+    return false;
+  }
+  jclass global_class = static_cast<jclass>(env->NewGlobalRef(local_class));
+  env->DeleteLocalRef(local_class);
+  if (env->ExceptionCheck() || !global_class) {
+    env->ExceptionClear();
+    LOG(ERROR) << "Unable to retain BrowserBridge class";
+    return false;
+  }
+
+  auto get_method = [env, global_class](const char* name,
+                                        const char* signature) -> jmethodID {
+    jmethodID method = env->GetStaticMethodID(global_class, name, signature);
+    if (env->ExceptionCheck()) {
+      env->ExceptionClear();
+      return nullptr;
+    }
+    return method;
+  };
+  jmethodID list_tabs =
+      get_method("listTabs", "()Ljava/lang/String;");
+  jmethodID current_tab =
+      list_tabs ? get_method("currentTab", "()Ljava/lang/String;") : nullptr;
+  jmethodID open_tab = current_tab
+                           ? get_method("openTab", "(Ljava/lang/String;)I")
+                           : nullptr;
+  jmethodID close_tab = open_tab ? get_method("closeTab", "(I)Z") : nullptr;
+  jmethodID navigate = close_tab
+                           ? get_method("navigate", "(ILjava/lang/String;)Z")
+                           : nullptr;
+  jmethodID eval_js =
+      navigate ? get_method("evalJs",
+                            "(ILjava/lang/String;)Ljava/lang/String;")
+               : nullptr;
+  if (!list_tabs || !current_tab || !open_tab || !close_tab || !navigate ||
+      !eval_js) {
+    env->DeleteGlobalRef(global_class);
+    LOG(ERROR) << "Unable to cache BrowserBridge methods";
+    return false;
+  }
+
+  g_jvm = jvm;
+  g_browser_bridge_class = global_class;
+  g_list_tabs_method = list_tabs;
+  g_current_tab_method = current_tab;
+  g_open_tab_method = open_tab;
+  g_close_tab_method = close_tab;
+  g_navigate_method = navigate;
+  g_eval_js_method = eval_js;
+  return true;
+}
