+class ScopedJNIEnv {
+ public:
+  ScopedJNIEnv() {
+    if (!g_jvm) {
+      return;
+    }
+
+    jint result = g_jvm->GetEnv(reinterpret_cast<void**>(&env_), JNI_VERSION_1_6);
+    if (result == JNI_EDETACHED) {
+      if (g_jvm->AttachCurrentThread(reinterpret_cast<void**>(&env_), nullptr) ==
+          JNI_OK) {
+        attached_ = true;
+      } else {
+        env_ = nullptr;
+      }
+    } else if (result != JNI_OK) {
+      env_ = nullptr;
+    }
+  }
+
+  ~ScopedJNIEnv() {
+    if (attached_) {
+      g_jvm->DetachCurrentThread();
+    }
+  }
+
+  JNIEnv* get() const { return env_; }
+
+ private:
+  JNIEnv* env_ = nullptr;
+  bool attached_ = false;
+};
+
+bool CheckJavaException(JNIEnv* env) {
+  jthrowable exception = env->ExceptionOccurred();
+  if (!exception) {
+    return false;
+  }
+  env->ExceptionClear();
+  env->DeleteLocalRef(exception);
+  PyErr_SetString(PyExc_RuntimeError, "browser: Java call failed");
+  return true;
+}
+
+PyObject* CallStringMethod(jmethodID method) {
+  ScopedJNIEnv scoped_env;
+  JNIEnv* env = scoped_env.get();
+  if (!env || !g_browser_bridge_class || !method) {
+    PyErr_SetString(PyExc_RuntimeError, "browser: JNI bridge unavailable");
+    return nullptr;
+  }
+
+  jstring result = static_cast<jstring>(
+      env->CallStaticObjectMethod(g_browser_bridge_class, method));
+  if (CheckJavaException(env)) {
+    return nullptr;
+  }
+  if (!result) {
+    return PyUnicode_FromString("");
+  }
+
+  // NB: GetStringUTFChars returns Modified UTF-8; PyUnicode_FromString
+  // expects standard UTF-8. The two differ only for U+0000 (impossible in
+  // URLs/titles, JSON-escaped in eval results). If it ever occurs,
+  // PyUnicode_FromString fails loudly with a Python exception — no crash.
+  const char* utf8 = env->GetStringUTFChars(result, nullptr);
+  if (!utf8) {
+    env->DeleteLocalRef(result);
+    if (env->ExceptionCheck()) {
+      env->ExceptionClear();
+    }
+    PyErr_SetString(PyExc_RuntimeError, "browser: Java call failed");
+    return nullptr;
+  }
+  PyObject* python_result = PyUnicode_FromString(utf8);
+  env->ReleaseStringUTFChars(result, utf8);
+  env->DeleteLocalRef(result);
+  return python_result;
+}
+
+PyObject* BrowserListTabs(PyObject*, PyObject* args) {
+  if (!PyArg_ParseTuple(args, ":list_tabs")) {
+    return nullptr;
+  }
+  return CallStringMethod(g_list_tabs_method);
+}
+
+PyObject* BrowserCurrentTab(PyObject*, PyObject* args) {
+  if (!PyArg_ParseTuple(args, ":current_tab")) {
+    return nullptr;
+  }
+  return CallStringMethod(g_current_tab_method);
+}
+
+PyObject* BrowserOpenTab(PyObject*, PyObject* args) {
+  const char* url = nullptr;
+  if (!PyArg_ParseTuple(args, "s:open_tab", &url)) {
+    return nullptr;
+  }
+
+  ScopedJNIEnv scoped_env;
+  JNIEnv* env = scoped_env.get();
+  if (!env || !g_browser_bridge_class || !g_open_tab_method) {
+    PyErr_SetString(PyExc_RuntimeError, "browser: JNI bridge unavailable");
+    return nullptr;
+  }
+  base::android::ScopedJavaLocalRef<jstring> java_url =
+      base::android::ConvertUTF8ToJavaString(env, url);
+  if (CheckJavaException(env) || !java_url) {
+    if (!PyErr_Occurred()) {
+      PyErr_SetString(PyExc_RuntimeError, "browser: Java call failed");
+    }
+    return nullptr;
+  }
+  jint result = env->CallStaticIntMethod(
+      g_browser_bridge_class, g_open_tab_method, java_url.obj());
+  if (CheckJavaException(env)) {
+    return nullptr;
+  }
+  return PyLong_FromLong(result);
+}
+
+PyObject* BrowserCloseTab(PyObject*, PyObject* args) {
+  int tab_id = 0;
+  if (!PyArg_ParseTuple(args, "i:close_tab", &tab_id)) {
+    return nullptr;
+  }
+
+  ScopedJNIEnv scoped_env;
+  JNIEnv* env = scoped_env.get();
+  if (!env || !g_browser_bridge_class || !g_close_tab_method) {
+    PyErr_SetString(PyExc_RuntimeError, "browser: JNI bridge unavailable");
+    return nullptr;
+  }
+  jboolean result = env->CallStaticBooleanMethod(
+      g_browser_bridge_class, g_close_tab_method, static_cast<jint>(tab_id));
+  if (CheckJavaException(env)) {
+    return nullptr;
+  }
+  return PyBool_FromLong(result == JNI_TRUE);
+}
+
+PyObject* BrowserNavigate(PyObject*, PyObject* args) {
+  int tab_id = 0;
+  const char* url = nullptr;
+  if (!PyArg_ParseTuple(args, "is:navigate", &tab_id, &url)) {
+    return nullptr;
+  }
+
+  ScopedJNIEnv scoped_env;
+  JNIEnv* env = scoped_env.get();
+  if (!env || !g_browser_bridge_class || !g_navigate_method) {
+    PyErr_SetString(PyExc_RuntimeError, "browser: JNI bridge unavailable");
+    return nullptr;
+  }
+  base::android::ScopedJavaLocalRef<jstring> java_url =
