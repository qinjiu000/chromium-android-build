+  if (CheckJavaException(env) || !java_url) {
+    if (!PyErr_Occurred()) {
+      PyErr_SetString(PyExc_RuntimeError, "browser: Java call failed");
+    }
+    return nullptr;
+  }
+  jboolean result = env->CallStaticBooleanMethod(
+      g_browser_bridge_class, g_navigate_method, static_cast<jint>(tab_id),
