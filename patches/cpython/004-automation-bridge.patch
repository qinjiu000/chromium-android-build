+package org.chromium.chrome.browser.cpython;
+
+import android.app.Activity;
+import android.os.Handler;
+import android.os.Looper;
+
+import org.chromium.base.ApplicationStatus;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.ChromeTabbedActivity;
+import org.chromium.chrome.browser.tab.Tab;
+import org.chromium.chrome.browser.tab.TabLaunchType;
+import org.chromium.chrome.browser.tabmodel.ChromeTabCreator;
+import org.chromium.chrome.browser.tabmodel.TabClosureParams;
+import org.chromium.chrome.browser.tabmodel.TabModel;
+import org.chromium.chrome.browser.tabmodel.TabModelSelector;
+import org.chromium.content_public.browser.JavaScriptCallback;
+import org.chromium.content_public.browser.LoadUrlParams;
+import org.chromium.content_public.browser.WebContents;
+import org.chromium.url.GURL;
+
+import java.util.concurrent.Callable;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicReference;
+
+/**
+ * UI-thread adapter for CPython browser automation.
+ *
+ * <p>Never call back into Python from UI-thread work: Python can hold the GIL
+ * while waiting for these calls, which would deadlock a UI-thread callback.
+ */
+@NullMarked
+public final class BrowserBridge {
+    private static final long DEFAULT_TIMEOUT_SECONDS = 10;
+    private static final long EVAL_TIMEOUT_SECONDS = 30;
+
+    private BrowserBridge() {}
+
+    /** Returns the normal tab model as a JSON array. */
+    public static String listTabs() {
+        return runOnUiThread(
+                () -> {
+                    ChromeTabbedActivity activity = getForegroundActivity();
+                    if (activity == null) {
+                        return "[]";
+                    }
+                    TabModel model = getNormalModel(activity);
+                    // Current tab OF THE NORMAL MODEL: index() is -1 when
+                    // empty and getTabAt() returns null for it, so this is
+                    // safe. (Do NOT use selector.getCurrentTab() here — it
+                    // follows the selected model, which may be incognito.)
+                    @Nullable Tab currentTab = model.getTabAt(model.index());
+                    StringBuilder json = new StringBuilder("[");
+                    for (int i = 0; i < model.getCount(); i++) {
+                        @Nullable Tab tab = model.getTabAt(i);
+                        if (tab == null) {
+                            continue;
+                        }
+                        if (json.length() > 1) {
+                            json.append(',');
+                        }
+                        appendTabJson(json, tab, currentTab);
+                    }
+                    return json.append(']').toString();
+                },
+                "[]");
+    }
+
+    /** Returns the selected normal tab as JSON, or {@code "null"} if absent. */
+    public static String currentTab() {
+        return runOnUiThread(
+                () -> {
+                    ChromeTabbedActivity activity = getForegroundActivity();
+                    if (activity == null) {
+                        return "null";
+                    }
+                    TabModel model = getNormalModel(activity);
+                    // Current tab of the normal model (see listTabs()).
+                    @Nullable Tab tab = model.getTabAt(model.index());
+                    if (tab == null) {
+                        return "null";
+                    }
+                    StringBuilder json = new StringBuilder();
+                    appendTabJson(json, tab, tab);
+                    return json.toString();
+                },
+                "null");
+    }
+
+    /** Opens a URL in a new normal tab and returns its tab id, or {@code -1}. */
+    public static int openTab(String url) {
+        return runOnUiThread(
+                () -> {
+                    ChromeTabbedActivity activity = getForegroundActivity();
+                    if (activity == null) {
+                        return -1;
+                    }
+                    ChromeTabCreator creator = activity.getTabCreator(false);
+                    @Nullable Tab tab =
+                            creator.createNewTab(
+                                    new LoadUrlParams(url),
+                                    TabLaunchType.FROM_CHROME_UI,
+                                    null);
+                    return tab == null ? -1 : tab.getId();
+                },
+                -1);
+    }
+
+    /** Closes the normal tab with {@code tabId}, returning whether it was found. */
+    public static boolean closeTab(int tabId) {
+        return runOnUiThread(
+                () -> {
+                    ChromeTabbedActivity activity = getForegroundActivity();
+                    if (activity == null) {
+                        return false;
+                    }
+                    TabModel model = getNormalModel(activity);
+                    @Nullable Tab tab = findTabById(model, tabId);
+                    if (tab == null) {
+                        return false;
+                    }
+                    model.getTabRemover()
+                            .closeTabs(TabClosureParams.closeTab(tab).build(), false);
+                    return true;
+                },
+                false);
+    }
+
+    /** Navigates the normal tab with {@code tabId}, returning whether it exists. */
+    public static boolean navigate(int tabId, String url) {
+        return runOnUiThread(
+                () -> {
+                    ChromeTabbedActivity activity = getForegroundActivity();
+                    if (activity == null) {
+                        return false;
+                    }
+                    @Nullable Tab tab = findTabById(getNormalModel(activity), tabId);
+                    if (tab == null) {
+                        return false;
+                    }
+                    tab.loadUrl(new LoadUrlParams(url));
+                    return true;
+                },
+                false);
+    }
+
+    /** Evaluates JavaScript in the normal tab; returns its JSON result or an error. */
+    public static String evalJs(int tabId, String script) {
+        CountDownLatch latch = new CountDownLatch(1);
+        AtomicReference<String> result =
+                new AtomicReference<>("ERROR: no foreground browser window");
+        boolean posted =
+                new Handler(Looper.getMainLooper())
+                        .post(
+                                () -> {
+                                    try {
+                                        ChromeTabbedActivity activity =
+                                                getForegroundActivity();
+                                        if (activity == null) {
+                                            latch.countDown();
+                                            return;
+                                        }
+                                        @Nullable Tab tab =
+                                                findTabById(
+                                                        getNormalModel(activity), tabId);
+                                        if (tab == null) {
+                                            result.set("ERROR: tab not found");
+                                            latch.countDown();
+                                            return;
+                                        }
+                                        @Nullable WebContents webContents =
+                                                tab.getWebContents();
+                                        if (webContents == null) {
+                                            result.set(
+                                                    "ERROR: tab has no web contents");
+                                            latch.countDown();
+                                            return;
+                                        }
+                                        webContents.evaluateJavaScript(
+                                                script,
+                                                new JavaScriptCallback() {
+                                                    @Override
+                                                    public void handleJavaScriptResult(
+                                                            String jsonResult) {
+                                                        result.set(
+                                                                jsonResult == null
+                                                                        ? ""
+                                                                        : jsonResult);
+                                                        latch.countDown();
+                                                    }
+                                                });
+                                    } catch (RuntimeException exception) {
+                                        result.set(
+                                                "ERROR: JavaScript evaluation failed");
+                                        latch.countDown();
+                                    }
+                                });
+        if (!posted) {
+            return "ERROR: unable to post to UI thread";
+        }
+        try {
+            if (!latch.await(EVAL_TIMEOUT_SECONDS, TimeUnit.SECONDS)) {
+                return "ERROR: timeout";
+            }
+        } catch (InterruptedException exception) {
+            Thread.currentThread().interrupt();
+            return "ERROR: interrupted";
+        }
+        return result.get();
+    }
+
+    private static <T> T runOnUiThread(Callable<T> action, T failureValue) {
+        CountDownLatch latch = new CountDownLatch(1);
+        AtomicReference<T> result = new AtomicReference<>(failureValue);
+        boolean posted =
+                new Handler(Looper.getMainLooper())
+                        .post(
+                                () -> {
+                                    try {
+                                        result.set(action.call());
+                                    } catch (Exception exception) {
+                                        result.set(failureValue);
+                                    } finally {
+                                        latch.countDown();
+                                    }
+                                });
+        if (!posted) {
+            return failureValue;
+        }
+        try {
+            if (!latch.await(DEFAULT_TIMEOUT_SECONDS, TimeUnit.SECONDS)) {
+                return failureValue;
+            }
+        } catch (InterruptedException exception) {
+            Thread.currentThread().interrupt();
+            return failureValue;
+        }
+        return result.get();
+    }
+
+    private static @Nullable ChromeTabbedActivity getForegroundActivity() {
+        @Nullable Activity activity =
+                ApplicationStatus.getLastTrackedFocusedActivity();
+        return activity instanceof ChromeTabbedActivity
+                ? (ChromeTabbedActivity) activity
+                : null;
+    }
+
+    private static TabModel getNormalModel(ChromeTabbedActivity activity) {
+        TabModelSelector selector = activity.getTabModelSelector();
+        return selector.getModel(false);
+    }
+
+    private static @Nullable Tab findTabById(TabModel model, int tabId) {
+        for (int i = 0; i < model.getCount(); i++) {
+            @Nullable Tab tab = model.getTabAt(i);
+            if (tab != null && tab.getId() == tabId) {
+                return tab;
+            }
+        }
+        return null;
+    }
+
+    private static void appendTabJson(
+            StringBuilder json, Tab tab, @Nullable Tab currentTab) {
+        @Nullable GURL tabUrl = tab.getUrl();
+        String url = tabUrl == null ? "" : tabUrl.toString();
+        @Nullable String tabTitle = tab.getTitle();
+        String title = tabTitle == null ? "" : tabTitle;
+        json.append("{\"id\":")
+                .append(tab.getId())
+                .append(",\"url\":\"")
+                .append(escapeJson(url))
+                .append("\",\"title\":\"")
+                .append(escapeJson(title))
+                .append("\",\"current\":")
+                .append(currentTab != null && currentTab.getId() == tab.getId())
+                .append('}');
+    }
+
+    private static String escapeJson(String value) {
+        StringBuilder escaped = new StringBuilder(value.length());
+        char[] hex = "0123456789abcdef".toCharArray();
+        for (int i = 0; i < value.length(); i++) {
+            char character = value.charAt(i);
