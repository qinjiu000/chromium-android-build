diff --git a/chrome/android/cpython/python_bridge.cc b/chrome/android/cpython/python_bridge.cc
new file mode 100644
index 0000000..90e2008
--- /dev/null
+++ b/chrome/android/cpython/python_bridge.cc
@@ -0,0 +1,303 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#define PY_SSIZE_T_CLEAN
+#include <Python.h>
+
+#include <atomic>
+#include <mutex>
+#include <string>
+#include <sys/stat.h>
+
+#include "base/android/jni_string.h"
+#include "base/android/scoped_java_ref.h"
+#include "base/logging.h"
+#include "chrome/android/cpython/jni_headers/PythonBridge_jni.h"
+#include "chrome/android/cpython/python_bridge.h"
+#include "third_party/jni_zero/jni_zero.h"
+
+namespace cpython {
+
+namespace {
+
+std::once_flag g_initialize_once;
+std::atomic<bool> g_initialized(false);
+// Retained for the process lifetime: PyEval_SaveThread() hands the GIL back
+// after init so later calls can re-acquire it via PyGILState_Ensure().
+PyThreadState* g_saved_thread_state = nullptr;
+
+bool AppendModuleSearchPath(PyConfig* config, const std::string& path) {
+  wchar_t* wide_path = Py_DecodeLocale(path.c_str(), nullptr);
+  if (!wide_path) {
+    return false;
+  }
+  PyStatus status =
+      PyWideStringList_Append(&config->module_search_paths, wide_path);
+  PyMem_RawFree(wide_path);
+  if (PyStatus_Exception(status)) {
+    return false;
+  }
+  return true;
+}
+
+std::string FormatPythonException() {
+  PyObject* exc_type = nullptr;
+  PyObject* exc_value = nullptr;
+  PyObject* exc_traceback = nullptr;
+  PyErr_Fetch(&exc_type, &exc_value, &exc_traceback);
+  PyErr_NormalizeException(&exc_type, &exc_value, &exc_traceback);
+
+  std::string formatted;
+  PyObject* traceback_module = PyImport_ImportModule("traceback");
+  if (traceback_module) {
+    PyObject* format_exception =
+        PyObject_GetAttrString(traceback_module, "format_exception");
+    if (format_exception) {
+      PyObject* formatted_lines = nullptr;
+      if (exc_value) {
+        formatted_lines = PyObject_CallOneArg(format_exception, exc_value);
+      } else if (exc_type) {
+        formatted_lines = PyObject_CallOneArg(format_exception, exc_type);
+      }
+      if (formatted_lines) {
+        PyObject* lines =
+            PySequence_Fast(formatted_lines, "traceback lines");
+        if (lines) {
+          Py_ssize_t length = PySequence_Fast_GET_SIZE(lines);
+          for (Py_ssize_t i = 0; i < length; ++i) {
+            PyObject* line = PySequence_Fast_GET_ITEM(lines, i);
+            const char* utf8 = PyUnicode_AsUTF8(line);
+            if (utf8) {
+              formatted.append(utf8);
+            }
+          }
+          Py_DECREF(lines);
+        }
+        Py_XDECREF(formatted_lines);
+      }
+      Py_XDECREF(format_exception);
+    }
+    Py_DECREF(traceback_module);
+  }
+
+  if (formatted.empty()) {
+    formatted = "Traceback (most recent call last):\n";
+    if (exc_value) {
+      PyObject* text = PyObject_Str(exc_value);
+      if (text) {
+        const char* utf8 = PyUnicode_AsUTF8(text);
+        if (utf8) {
+          formatted.append(utf8);
+          formatted.push_back('\n');
+        }
+        Py_DECREF(text);
+      }
+    }
+  }
+
+  Py_XDECREF(exc_type);
+  Py_XDECREF(exc_value);
+  Py_XDECREF(exc_traceback);
+  PyErr_Clear();
+  return formatted;
+}
+
+void RestoreRedirect(PyObject* sys_module,
+                     PyObject* original_stdout,
+                     PyObject* original_stderr) {
+  if (original_stdout) {
+    PyObject_SetAttrString(sys_module, "stdout", original_stdout);
+  }
+  if (original_stderr) {
+    PyObject_SetAttrString(sys_module, "stderr", original_stderr);
+  }
+  PyErr_Clear();
+}
+
+}  // namespace
+
+bool Initialize(const std::string& stdlib_dir,
+                const std::string& native_lib_dir,
+                const std::string& cache_dir) {
+  std::call_once(g_initialize_once, [&]() {
+    mkdir(cache_dir.c_str(), 0700);
+
+    PyConfig config;
+    PyConfig_InitIsolatedConfig(&config);
+
+    PyStatus status =
+        PyConfig_SetBytesString(&config, &config.program_name, "chrome");
+    if (!PyStatus_Exception(status)) {
+      status =
+          PyConfig_SetBytesString(&config, &config.base_executable, "chrome");
+    }
+    if (!PyStatus_Exception(status)) {
+      status =
+          PyConfig_SetBytesString(&config, &config.pycache_prefix,
+                                  cache_dir.c_str());
+    }
+    if (PyStatus_Exception(status)) {
+      PyConfig_Clear(&config);
+      return;
+    }
+
+    config.module_search_paths_set = 1;
+    if (!AppendModuleSearchPath(&config, stdlib_dir) ||
+        !AppendModuleSearchPath(&config, native_lib_dir)) {
+      PyConfig_Clear(&config);
+      return;
+    }
+
+    status = Py_InitializeFromConfig(&config);
+    PyConfig_Clear(&config);
+    if (PyStatus_Exception(status)) {
+      return;
+    }
+
+    g_saved_thread_state = PyEval_SaveThread();
+    g_initialized.store(true);
+    LOG(INFO) << "CPython 3.13.16 initialized";
+  });
+  return g_initialized.load();
+}
+
+bool IsInitialized() {
+  return g_initialized.load();
+}
+
+std::string Eval(const std::string& code) {
+  if (!g_initialized.load()) {
+    return "CPython is not initialized";
+  }
+
+  PyGILState_STATE gil_state = PyGILState_Ensure();
+
+  PyObject* sys_module = PyImport_AddModule("sys");
+  PyObject* original_stdout =
+      sys_module ? PyObject_GetAttrString(sys_module, "stdout") : nullptr;
+  PyObject* original_stderr =
+      sys_module ? PyObject_GetAttrString(sys_module, "stderr") : nullptr;
+
+  PyObject* io_module = PyImport_ImportModule("io");
+  PyObject* string_io_class =
+      io_module ? PyObject_GetAttrString(io_module, "StringIO") : nullptr;
+  PyObject* string_io =
+      string_io_class ? PyObject_CallNoArgs(string_io_class) : nullptr;
+  PyObject* main_module = PyImport_AddModule("__main__");
+  PyObject* globals =
+      main_module ? PyModule_GetDict(main_module) : nullptr;
+
+  if (!sys_module || !original_stdout || !original_stderr || !io_module ||
+      !string_io_class || !string_io || !globals) {
+    std::string result = FormatPythonException();
+    if (sys_module && original_stdout) {
+      PyObject_SetAttrString(sys_module, "stdout", original_stdout);
+    }
+    if (sys_module && original_stderr) {
+      PyObject_SetAttrString(sys_module, "stderr", original_stderr);
+    }
+    PyErr_Clear();
+    Py_XDECREF(string_io);
+    Py_XDECREF(string_io_class);
+    Py_XDECREF(io_module);
+    Py_XDECREF(original_stderr);
+    Py_XDECREF(original_stdout);
+    PyGILState_Release(gil_state);
+    return result;
+  }
+
+  PyObject_SetAttrString(sys_module, "stdout", string_io);
+  PyObject_SetAttrString(sys_module, "stderr", string_io);
+  if (PyErr_Occurred()) {
+    std::string result = FormatPythonException();
+    RestoreRedirect(sys_module, original_stdout, original_stderr);
+    Py_XDECREF(string_io);
+    Py_XDECREF(string_io_class);
+    Py_XDECREF(io_module);
+    Py_XDECREF(original_stderr);
+    Py_XDECREF(original_stdout);
+    PyGILState_Release(gil_state);
+    return result;
+  }
+
+  PyObject* compiled =
+      Py_CompileString(code.c_str(), "<console>", Py_file_input);
+  if (!compiled) {
+    std::string result = FormatPythonException();
+    RestoreRedirect(sys_module, original_stdout, original_stderr);
+    Py_XDECREF(string_io);
+    Py_XDECREF(string_io_class);
+    Py_XDECREF(io_module);
+    Py_XDECREF(original_stderr);
+    Py_XDECREF(original_stdout);
+    PyGILState_Release(gil_state);
+    return result;
+  }
+
+  PyObject* evaluated =
+      PyEval_EvalCode(compiled, globals, globals);
+  Py_DECREF(compiled);
+  if (!evaluated) {
+    std::string result = FormatPythonException();
+    RestoreRedirect(sys_module, original_stdout, original_stderr);
+    Py_XDECREF(string_io);
+    Py_XDECREF(string_io_class);
+    Py_XDECREF(io_module);
+    Py_XDECREF(original_stderr);
+    Py_XDECREF(original_stdout);
+    PyGILState_Release(gil_state);
+    return result;
+  }
+  Py_DECREF(evaluated);
+
+  std::string result;
+  // NB: PyObject_CallMethodNoArgs takes a PyObject* name; the const-char*
+  // form is PyObject_CallMethod with a NULL format (no args).
+  PyObject* getvalue = PyObject_CallMethod(string_io, "getvalue", nullptr);
+  if (!getvalue) {
+    result = FormatPythonException();
+  } else {
+    const char* utf8 = PyUnicode_AsUTF8(getvalue);
+    if (utf8) {
+      result = utf8;
+    } else {
+      result = FormatPythonException();
+    }
+    Py_DECREF(getvalue);
+  }
+
+  RestoreRedirect(sys_module, original_stdout, original_stderr);
+  Py_XDECREF(string_io);
+  Py_XDECREF(string_io_class);
+  Py_XDECREF(io_module);
+  Py_XDECREF(original_stderr);
+  Py_XDECREF(original_stdout);
+  PyGILState_Release(gil_state);
+  return result;
+}
+
+static bool JNI_PythonBridge_NativeInitialize(
+    JNIEnv* env,
+    const base::android::JavaRef<jstring>& stdlib_dir,
+    const base::android::JavaRef<jstring>& native_lib_dir,
+    const base::android::JavaRef<jstring>& cache_dir) {
+  std::string stdlib = base::android::ConvertJavaStringToUTF8(env, stdlib_dir);
+  std::string native_lib =
+      base::android::ConvertJavaStringToUTF8(env, native_lib_dir);
+  std::string cache =
+      base::android::ConvertJavaStringToUTF8(env, cache_dir);
+  return Initialize(stdlib, native_lib, cache);
+}
+
+static base::android::ScopedJavaLocalRef<jstring>
+JNI_PythonBridge_NativeEval(
+    JNIEnv* env,
+    const base::android::JavaRef<jstring>& code) {
+  std::string source = base::android::ConvertJavaStringToUTF8(env, code);
+  return base::android::ConvertUTF8ToJavaString(env, Eval(source));
+}
+
+}  // namespace cpython
+
+DEFINE_JNI(PythonBridge)
