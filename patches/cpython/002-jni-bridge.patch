diff --git a/chrome/android/java/src/org/chromium/chrome/browser/cpython/PythonBridge.java b/chrome/android/java/src/org/chromium/chrome/browser/cpython/PythonBridge.java
new file mode 100644
index 0000000..83d90d0
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/cpython/PythonBridge.java
@@ -0,0 +1,167 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.cpython;
+
+import android.content.Context;
+
+import org.jni_zero.JNINamespace;
+import org.jni_zero.NativeMethods;
+
+import org.chromium.build.annotations.NullMarked;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipInputStream;
+
+@JNINamespace("cpython")
+@NullMarked
+public final class PythonBridge {
+    private static final String PYTHON_DIRECTORY = "python";
+    private static final String STDLIB_DIRECTORY = "stdlib";
+    private static final String PYCACHE_DIRECTORY = "pycache";
+    private static final String MARKER_FILE = ".stdlib-version";
+    private static final String MARKER_VERSION = "3.13.16-0";
+
+    private static volatile boolean sInitialized;
+
+    private PythonBridge() {}
+
+    /**
+     * Initializes CPython. Call from any background thread, exactly once for the process.
+     *
+     * @param context Android context used to locate application files and native libraries.
+     */
+    public static void initialize(Context context) {
+        synchronized (PythonBridge.class) {
+            if (sInitialized) {
+                return;
+            }
+
+            File pythonDir = new File(context.getFilesDir(), PYTHON_DIRECTORY);
+            File stdlibDir = new File(pythonDir, STDLIB_DIRECTORY);
+            File cacheDir = new File(pythonDir, PYCACHE_DIRECTORY);
+            File marker = new File(pythonDir, MARKER_FILE);
+
+            try {
+                if (!marker.exists()
+                        || !new String(
+                                        Files.readAllBytes(marker.toPath()),
+                                        StandardCharsets.UTF_8)
+                                .trim()
+                                .equals(MARKER_VERSION)) {
+                    extractStdlib(context, stdlibDir);
+                    if (!pythonDir.isDirectory() && !pythonDir.mkdirs()) {
+                        throw new IOException("Unable to create Python directory");
+                    }
+                    try (OutputStream output =
+                            new FileOutputStream(marker)) {
+                        output.write(MARKER_VERSION.getBytes(StandardCharsets.UTF_8));
+                    }
+                }
+                if (!cacheDir.isDirectory() && !cacheDir.mkdirs()) {
+                    throw new IOException("Unable to create Python cache directory");
+                }
+            } catch (IOException | RuntimeException exception) {
+                throw new IllegalStateException(
+                        "Unable to prepare CPython files", exception);
+            }
+
+            if (!PythonBridgeJni.get()
+                    .nativeInitialize(
+                            stdlibDir.getAbsolutePath(),
+                            context.getApplicationInfo().nativeLibraryDir,
+                            cacheDir.getAbsolutePath())) {
+                throw new IllegalStateException("Unable to initialize CPython");
+            }
+            sInitialized = true;
+        }
+    }
+
+    /**
+     * Evaluates Python code. Call only from the single Python executor thread.
+     *
+     * @param code Python source to compile and execute.
+     * @return Captured stdout/stderr text, or formatted traceback text on error.
+     */
+    public static String eval(String code) {
+        if (!sInitialized) {
+            throw new IllegalStateException("CPython is not initialized");
+        }
+        return PythonBridgeJni.get().nativeEval(code);
+    }
+
+    /** Returns whether this Java process has initialized CPython. */
+    public static boolean isInitialized() {
+        return sInitialized;
+    }
+
+    private static void extractStdlib(Context context, File stdlibDir)
+            throws IOException {
+        if (!stdlibDir.isDirectory() && !stdlibDir.mkdirs()) {
+            throw new IOException("Unable to create Python stdlib directory");
+        }
+
+        File canonicalRoot = stdlibDir.getCanonicalFile();
+        String rootPath = canonicalRoot.getPath();
+        byte[] buffer = new byte[8192];
+
+        try (InputStream asset =
+                        context.getAssets().open("python_stdlib.zip");
+                ZipInputStream zip = new ZipInputStream(asset)) {
+            ZipEntry entry;
+            while ((entry = zip.getNextEntry()) != null) {
+                String entryName = entry.getName();
+                if (entryName.startsWith("/")
+                        || entryName.contains("\\")
+                        || entryName.contains("../")
+                        || entryName.contains("..\\")) {
+                    throw new IOException("Invalid stdlib zip entry: " + entryName);
+                }
+
+                File output = new File(canonicalRoot, entryName).getCanonicalFile();
+                if (!output.getPath().equals(rootPath)
+                        && !output.getPath().startsWith(rootPath + File.separator)) {
+                    throw new IOException("Zip-slip stdlib entry: " + entryName);
+                }
+
+                if (entry.isDirectory()) {
+                    if (!output.isDirectory() && !output.mkdirs()) {
+                        throw new IOException(
+                                "Unable to create stdlib directory: " + output);
+                    }
+                } else {
+                    File parent = output.getParentFile();
+                    if (parent != null
+                            && !parent.isDirectory()
+                            && !parent.mkdirs()) {
+                        throw new IOException(
+                                "Unable to create stdlib parent: " + parent);
+                    }
+                    try (OutputStream outputStream = new FileOutputStream(output)) {
+                        int read;
+                        while ((read = zip.read(buffer)) != -1) {
+                            outputStream.write(buffer, 0, read);
+                        }
+                    }
+                }
+                zip.closeEntry();
+            }
+        }
+    }
+
+    @NativeMethods
+    interface Natives {
+        boolean nativeInitialize(
+                String stdlibDir, String nativeLibDir, String cacheDir);
+
+        String nativeEval(String code);
+    }
+}
