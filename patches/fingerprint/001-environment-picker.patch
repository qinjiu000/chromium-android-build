@@ -0,0 +1,184 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.environments;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.content.Intent;
+import android.os.Bundle;
+import android.os.StrictMode;
+import android.view.View;
+import android.widget.AdapterView;
+import android.widget.ArrayAdapter;
+import android.widget.Button;
+import android.widget.EditText;
+import android.widget.LinearLayout;
+import android.widget.ListView;
+import android.widget.Toast;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/** Shows the available environments before starting the browser. */
+@NullMarked
+public class EnvironmentPickerActivity extends Activity {
+    private final List<EnvironmentManager.Environment> mEnvironments = new ArrayList<>();
+    private @Nullable ArrayAdapter<String> mAdapter;
+    private @Nullable LinearLayout mCreateForm;
+    private @Nullable EditText mCreateEnvironmentName;
+
+    /** Ensures an initial environment exists before displaying the picker. */
+    @Override
+    protected void onCreate(@Nullable Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        // First access loads the environment preferences file from disk.
+        StrictMode.ThreadPolicy oldPolicy = StrictMode.allowThreadDiskReads();
+        try {
+            EnvironmentManager.ensureDefaultEnvironment(this);
+        } finally {
+            StrictMode.setThreadPolicy(oldPolicy);
+        }
+
+        LinearLayout layout = new LinearLayout(this);
+        layout.setOrientation(LinearLayout.VERTICAL);
+
+        Button createButton = new Button(this);
+        // TODO: Move UI strings into Android resources.
+        createButton.setText("新建环境");
+        createButton.setOnClickListener(view -> showCreateForm());
+        layout.addView(createButton);
+
+        LinearLayout createForm = new LinearLayout(this);
+        createForm.setOrientation(LinearLayout.VERTICAL);
+        createForm.setVisibility(View.GONE);
+        mCreateForm = createForm;
+
+        EditText nameInput = new EditText(this);
+        nameInput.setHint("环境名称");
+        nameInput.setSingleLine(true);
+        mCreateEnvironmentName = nameInput;
+        createForm.addView(nameInput);
+
+        LinearLayout createActions = new LinearLayout(this);
+        Button saveButton = new Button(this);
+        saveButton.setText("创建");
+        saveButton.setOnClickListener(view -> createEnvironment());
+        createActions.addView(saveButton);
+
+        Button cancelButton = new Button(this);
+        cancelButton.setText("取消");
+        cancelButton.setOnClickListener(view -> hideCreateForm());
+        createActions.addView(cancelButton);
+        createForm.addView(createActions);
+        layout.addView(createForm);
+
+        ListView listView = new ListView(this);
+        ArrayAdapter<String> adapter =
+                new ArrayAdapter<>(this, android.R.layout.simple_list_item_1, new ArrayList<>());
+        mAdapter = adapter;
+        listView.setAdapter(adapter);
+        listView.setOnItemClickListener(this::onEnvironmentClicked);
+        listView.setOnItemLongClickListener(this::onEnvironmentLongClicked);
+        layout.addView(listView);
+
+        setContentView(layout);
+        refreshEnvironments();
+    }
+
+    /** Opens the chosen environment in ChromeTabbedActivity. */
+    private void onEnvironmentClicked(AdapterView<?> parent, View view, int position, long itemId) {
+        EnvironmentManager.Environment environment = mEnvironments.get(position);
+        StrictMode.ThreadPolicy oldPolicy = StrictMode.allowThreadDiskWrites();
+        try {
+            EnvironmentManager.ensureEnvironmentDirectories(this, environment);
+        } catch (IllegalStateException e) {
+            Toast.makeText(this, "无法准备环境目录：" + e.getMessage(), Toast.LENGTH_LONG).show();
+            return;
+        } finally {
+            StrictMode.setThreadPolicy(oldPolicy);
+        }
+        EnvironmentManager.setCurrentEnvironment(this, environment.id);
+        Intent intent = new Intent(Intent.ACTION_MAIN);
+        intent.addCategory(Intent.CATEGORY_LAUNCHER);
+        intent.setClassName(this, "org.chromium.chrome.browser.ChromeTabbedActivity");
+        intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TASK);
+        startActivity(intent);
+        finish();
+    }
+
+    /** Prompts for confirmation before deleting the selected environment. */
+    private boolean onEnvironmentLongClicked(
+            AdapterView<?> parent, View view, int position, long itemId) {
+        EnvironmentManager.Environment environment = mEnvironments.get(position);
+        // TODO: Move UI strings into Android resources.
+        new AlertDialog.Builder(this)
+                .setTitle("删除环境")
+                .setMessage("确定删除“" + environment.name + "”吗？")
+                .setNegativeButton("取消", null)
+                .setPositiveButton(
+                        "删除",
+                        (dialog, which) -> {
+                            if (!EnvironmentManager.deleteEnvironment(this, environment.id)) {
+                                Toast.makeText(this, "删除环境失败", Toast.LENGTH_SHORT).show();
+                            }
+                            refreshEnvironments();
+                        })
+                .show();
+        return true;
+    }
+
+    private void showCreateForm() {
+        LinearLayout form = mCreateForm;
+        EditText nameInput = mCreateEnvironmentName;
+        if (form == null || nameInput == null) return;
+        form.setVisibility(View.VISIBLE);
+        nameInput.requestFocus();
+    }
+
+    private void hideCreateForm() {
+        LinearLayout form = mCreateForm;
+        EditText nameInput = mCreateEnvironmentName;
+        if (nameInput != null) nameInput.setText("");
+        if (form != null) form.setVisibility(View.GONE);
+    }
+
+    private void createEnvironment() {
+        EditText nameInput = mCreateEnvironmentName;
+        if (nameInput == null) return;
+        String name = nameInput.getText().toString().trim();
+        if (name.isEmpty()) {
+            Toast.makeText(this, "请输入环境名称", Toast.LENGTH_SHORT).show();
+            return;
+        }
+        try {
+            EnvironmentManager.createEnvironment(this, name);
+            refreshEnvironments();
+            hideCreateForm();
+        } catch (RuntimeException e) {
+            Toast.makeText(this, "创建环境失败：" + e.getMessage(), Toast.LENGTH_LONG).show();
+        }
+    }
+
+    /** Reloads the environment list shown by the adapter. */
+    private void refreshEnvironments() {
+        ArrayAdapter<String> adapter = mAdapter;
+        if (adapter == null) return;
+        StrictMode.ThreadPolicy oldPolicy = StrictMode.allowThreadDiskReads();
+        try {
+            mEnvironments.clear();
+            mEnvironments.addAll(EnvironmentManager.getEnvironments(this));
+        } finally {
+            StrictMode.setThreadPolicy(oldPolicy);
+        }
+        adapter.clear();
+        for (EnvironmentManager.Environment environment : mEnvironments) {
+            adapter.add(environment.name);
+        }
+        adapter.notifyDataSetChanged();
+    }
+}
