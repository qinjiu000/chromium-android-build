@@ -0,0 +1,244 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.environments;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.os.StrictMode;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import org.chromium.base.CommandLine;
+import org.chromium.base.PathUtils;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+import java.io.File;
+import java.security.SecureRandom;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.UUID;
+
+/** Manages persisted browser environments and their startup configuration. */
+@NullMarked
+public class EnvironmentManager {
+    private static final String PREFERENCES_NAME = "fingerprint_environments";
+    private static final String ENVIRONMENTS_KEY = "environments";
+    private static final String CURRENT_ENVIRONMENT_ID_KEY = "current_env_id";
+    private static final String MANIFEST_VERSION_KEY = "manifest_version";
+    private static final long MAX_SEED = 0xFFFFFFFFL;
+
+    /** Represents one persisted browser environment. */
+    public static class Environment {
+        public final String id;
+        public final String name;
+        public final long seed;
+
+        /** Creates an environment value. */
+        public Environment(String id, String name, long seed) {
+            this.id = id;
+            this.name = name;
+            this.seed = seed;
+        }
+    }
+
+    /** Returns all valid environments, or an empty list if stored data is unreadable. */
+    public static List<Environment> getEnvironments(Context context) {
+        List<Environment> environments = new ArrayList<>();
+        try {
+            @Nullable String serialized = getPreferences(context).getString(ENVIRONMENTS_KEY, "[]");
+            if (serialized == null) return environments;
+            JSONArray array = new JSONArray(serialized);
+            for (int i = 0; i < array.length(); ++i) {
+                JSONObject entry = array.getJSONObject(i);
+                String id = entry.getString("id");
+                String name = entry.getString("name");
+                long seed = entry.getLong("seed");
+                if (!isValidId(id) || seed < 0 || seed > MAX_SEED) continue;
+                environments.add(new Environment(id, name, seed));
+            }
+        } catch (Exception e) {
+            return new ArrayList<>();
+        }
+        return environments;
+    }
+
+    /** Returns the current environment, or null if its ID is not in the stored list. */
+    public static @Nullable Environment getCurrentEnvironment(Context context) {
+        @Nullable String currentId =
+                getPreferences(context).getString(CURRENT_ENVIRONMENT_ID_KEY, null);
+        if (currentId == null) return null;
+        for (Environment environment : getEnvironments(context)) {
+            if (environment.id.equals(currentId)) return environment;
+        }
+        return null;
+    }
+
+    /** Marks the environment with the given ID as current. */
+    public static void setCurrentEnvironment(Context context, String id) {
+        getPreferences(context)
+                .edit()
+                .putString(CURRENT_ENVIRONMENT_ID_KEY, id)
+                .putInt(MANIFEST_VERSION_KEY, 1)
+                .apply();
+    }
+
+    /** Creates, persists, and returns a new environment. */
+    public static Environment createEnvironment(Context context, String name) {
+        Environment environment =
+                new Environment(
+                        UUID.randomUUID().toString(),
+                        name,
+                        new SecureRandom().nextLong() & MAX_SEED);
+        List<Environment> environments = getEnvironments(context);
+        environments.add(environment);
+        saveEnvironments(context, environments);
+        return environment;
+    }
+
+    /** Deletes an environment's directories before removing its stored metadata. */
+    public static boolean deleteEnvironment(Context context, String id) {
+        Environment environment = findEnvironment(context, id);
+        if (environment == null) return false;
+        if (!deleteRecursively(getUserDataDir(context, environment))
+                || !deleteRecursively(getCacheDir(context, environment))) {
+            return false;
+        }
+
+        List<Environment> environments = getEnvironments(context);
+        List<Environment> remainingEnvironments = new ArrayList<>();
+        for (Environment candidate : environments) {
+            if (!candidate.id.equals(id)) remainingEnvironments.add(candidate);
+        }
+        SharedPreferences.Editor editor =
+                getPreferences(context)
+                        .edit()
+                        .putString(ENVIRONMENTS_KEY, toJson(remainingEnvironments));
+        if (id.equals(getPreferences(context).getString(CURRENT_ENVIRONMENT_ID_KEY, null))) {
+            editor.remove(CURRENT_ENVIRONMENT_ID_KEY);
+        }
+        editor.putInt(MANIFEST_VERSION_KEY, 1).apply();
+        return true;
+    }
+
+    /** Returns the environment's user data directory. */
+    public static File getUserDataDir(Context context, Environment environment) {
+        return new File(PathUtils.getDataDirectory(), "envs/" + environment.id);
+    }
+
+    /** Returns the environment's cache directory. */
+    public static File getCacheDir(Context context, Environment environment) {
+        return new File(context.getCacheDir(), "envs/" + environment.id);
+    }
+
+    /** Creates the selected environment's user-data and cache directories. */
+    public static void ensureEnvironmentDirectories(Context context, Environment environment) {
+        ensureDirectory(getUserDataDir(context, environment));
+        ensureDirectory(getCacheDir(context, environment));
+    }
+
+    /** Creates and selects the default environment if no environments are stored. */
+    public static Environment ensureDefaultEnvironment(Context context) {
+        List<Environment> environments = getEnvironments(context);
+        if (environments.isEmpty()) {
+            Environment environment = createEnvironment(context, "默认环境");
+            setCurrentEnvironment(context, environment.id);
+            return environment;
+        }
+
+        Environment current = getCurrentEnvironment(context);
+        if (current != null) return current;
+        setCurrentEnvironment(context, environments.get(0).id);
+        return environments.get(0);
+    }
+
+    /** Adds the current environment's user-data, cache, and seed command-line switches. */
+    public static void applyEnvironmentSwitches(Context context) {
+        StrictMode.ThreadPolicy oldPolicy = StrictMode.allowThreadDiskReadsWrites();
+        try {
+            Environment environment = getCurrentEnvironment(context);
+            if (environment == null) environment = ensureDefaultEnvironment(context);
+            ensureEnvironmentDirectories(context, environment);
+            CommandLine commandLine = CommandLine.getInstance();
+            commandLine.appendSwitchWithValue(
+                    "user-data-dir", getUserDataDir(context, environment).getAbsolutePath());
+            commandLine.appendSwitchWithValue(
+                    "disk-cache-dir", getCacheDir(context, environment).getAbsolutePath());
+            commandLine.appendSwitchWithValue("stealth-seed", Long.toString(environment.seed));
+        } finally {
+            StrictMode.setThreadPolicy(oldPolicy);
+        }
+    }
+
+    /** Returns the application's dedicated environment preferences. */
+    private static SharedPreferences getPreferences(Context context) {
+        return context.getSharedPreferences(PREFERENCES_NAME, Context.MODE_PRIVATE);
+    }
+
+    /** Finds a stored environment by ID. */
+    private static @Nullable Environment findEnvironment(Context context, String id) {
+        for (Environment environment : getEnvironments(context)) {
+            if (environment.id.equals(id)) return environment;
+        }
+        return null;
+    }
+
+    /** Saves the environment list and manifest version. */
+    private static void saveEnvironments(Context context, List<Environment> environments) {
+        getPreferences(context)
+                .edit()
+                .putString(ENVIRONMENTS_KEY, toJson(environments))
+                .putInt(MANIFEST_VERSION_KEY, 1)
+                .apply();
+    }
+
+    /** Serializes environment values into the persisted JSON array. */
+    private static String toJson(List<Environment> environments) {
+        JSONArray array = new JSONArray();
+        for (Environment environment : environments) {
+            JSONObject entry = new JSONObject();
+            try {
+                entry.put("id", environment.id);
+                entry.put("name", environment.name);
+                entry.put("seed", environment.seed);
+            } catch (JSONException e) {
+                throw new IllegalStateException(e);
+            }
+            array.put(entry);
+        }
+        return array.toString();
+    }
+
+    /** Checks that an ID is a canonical UUID before using it in a filesystem path. */
+    private static boolean isValidId(String id) {
+        try {
+            return UUID.fromString(id).toString().equals(id);
+        } catch (IllegalArgumentException e) {
+            return false;
+        }
+    }
+
+    private static void ensureDirectory(File directory) {
+        if (directory.isDirectory()) return;
+        if (!directory.mkdirs() && !directory.isDirectory()) {
+            throw new IllegalStateException("Unable to create environment directory: " + directory);
+        }
+    }
+
+    /** Removes a file or directory tree, returning false if any deletion fails. */
+    private static boolean deleteRecursively(File file) {
+        if (!file.exists()) return true;
+        if (file.isDirectory()) {
+            File[] children = file.listFiles();
+            if (children == null) return false;
+            for (File child : children) {
+                if (!deleteRecursively(child)) return false;
+            }
+        }
+        return file.delete();
+    }
+}
