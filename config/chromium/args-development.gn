# =============================================================================
# GN arguments: DEVELOPMENT channel (debug build)
#
# This is the iNWEB-Browser development configuration, the only config with
# a publicly verified full chrome_public_apk build on free GitHub-hosted
# runners (iNWEB chain B-001, Chromium 154, 14 hops, 2026-09-22).
# No public case of an official (ThinLTO/PGO) Android build on free runners
# exists, so the debug build is the target until this chain proves itself.
#
# Reference: upstream docs/android_build_instructions.md
# =============================================================================

# Android target on an x86-64 Linux build host, 64-bit ARM device target.
target_os = "android"
target_cpu = "arm64"

# Debug + symbol_level=1 is the fast-iteration config iNWEB proved.
# NOTE: component builds are disallowed on Android upstream
# (BUILDCONFIG.gn asserts !(current_os == "android" && is_component_build))
# — is_component_build must NEVER be set here.
is_debug = true
symbol_level = 1

# Distribution outside Play Store during development.
android_channel = "default"

# Deviation from iNWEB (verified against the Chromium 159 tree,
# build/config/android/config.gni): turn the Java static-analysis steps off.
# iNWEB hit hop 13's AUTONINJA_BUILD_ID failure in exactly those steps
# (android_static_analysis=build_server Java validate_deps). "off" is the
# same value is_official_build selects, and it removes the failing steps
# instead of working around them. build_android.sh still exports
# AUTONINJA_BUILD_ID as belt-and-braces.
android_static_analysis = "off"

# =============================================================================
# Selective de-Google, Phase 1 — same block as args-release.gn (see there
# for the full rationale). The debug build carries the same de-Google
# configuration so the patches and flags can be iterated on the faster
# debug chain before the release chain runs.
# =============================================================================
google_api_key = ""
google_default_client_id = ""
google_default_client_secret = ""
use_official_google_api_keys = false
disable_fieldtrial_testing_config = true
enable_hangout_services_extension = false
enable_mdns = false
enable_reporting = false
enable_service_discovery = false
use_on_device_model_service = false
treat_warnings_as_errors = false
enable_desktop_android_extensions = true

# Deliberately NOT set:
# - enable_nacl: removed from the Chromium tree (no such arg in 159);
#   passing it would fail gn gen.
# - blink_symbol_level / v8_symbol_level: left at their defaults, which
#   follow symbol_level=1 (iNWEB-faithful).
# - is_java_debug: defaults to is_debug (true here).
# - use_thin_lto: defaults off for non-official builds; leave alone.
# - safe_browsing_mode: keep the default (Safe Browsing stays ON).
# - enable_remoting: already false on Android.
